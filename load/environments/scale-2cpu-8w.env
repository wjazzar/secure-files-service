# Point 3 — le même nœud de 2 CPU, avec 8 workers : ce que donne un nœud
# réaliste quand ni le processeur seul ni les workers seuls ne brident.
BACKEND_CPUS=2.0
BACKEND_MEMORY=1g
# Détection de fuite Hikari à 2 s : une connexion gardée plus longtemps est
# journalisée avec l'endroit où elle a été prise (rapport *-database.md).
BACKEND_JVM_OPTIONS=-XX:+UseG1GC -Dspring.datasource.hikari.leak-detection-threshold=2000
WORKER_CONCURRENCY=8
ANTIVIRUS_MODE=http

LOAD_RATES=100,130,160,200
LOAD_STEP=60s
LOAD_WARMUP_RATE=80
LOAD_WARMUP=60s
MAX_VUS=300
CONCURRENT_UPLOADS=50
CONCURRENT_FILE_SIZE_BYTES=2097152
