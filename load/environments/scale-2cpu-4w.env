# Point 3 — un nœud de 2 CPU, 4 workers, 1 Gio comme les autres gabarits.
# Sous ~1,8 Gio, la JVM se croit « petite machine » et choisirait SerialGC :
# G1 est imposé, comme sur un nœud réaliste (le rapport affiche le GC actif).
BACKEND_CPUS=2.0
BACKEND_MEMORY=1g
BACKEND_JVM_OPTIONS=-XX:+UseG1GC
WORKER_CONCURRENCY=4
ANTIVIRUS_MODE=http

LOAD_RATES=80,100,120,150
LOAD_STEP=60s
LOAD_WARMUP_RATE=60
LOAD_WARMUP=60s
MAX_VUS=200
CONCURRENT_UPLOADS=50
CONCURRENT_FILE_SIZE_BYTES=2097152
