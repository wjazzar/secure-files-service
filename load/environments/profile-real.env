# Point 2 — où part le temps. Même nœud que les confirmations (1 CPU, 1 Gio,
# 4 workers, ClamAV réel), avec l'enregistrement JFR du nœud et le relevé
# docker stats de chaque conteneur. Deux paliers longs (180 s) : assez
# d'échantillons pour le profil, et le palier 80 tenu trois fois plus
# longtemps que dans les confirmations. JFR coûte quelques pour cent : ces
# chiffres éclairent, ils ne remplacent pas les confirmations.
BACKEND_CPUS=1.0
BACKEND_MEMORY=1g
WORKER_CONCURRENCY=4
ANTIVIRUS_MODE=http
JFR=true

LOAD_RATES=50,80
LOAD_STEP=180s
LOAD_WARMUP_RATE=30
LOAD_WARMUP=60s
CONCURRENT_UPLOADS=50
CONCURRENT_FILE_SIZE_BYTES=2097152
