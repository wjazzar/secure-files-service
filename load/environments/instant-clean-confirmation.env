# Repeat twice more and take the median with the saturation control campaign.
BACKEND_CPUS=1.0
BACKEND_MEMORY=1g
WORKER_CONCURRENCY=4
ANTIVIRUS_MODE=instant-clean
SPRING_PROFILES_ACTIVE=capacity

LOAD_RATES=100,120,150
LOAD_STEP=60s
# The code-only path reaches much higher rates and needs a representative JIT,
# connection-pool and object-store warm-up before the first measured stage.
LOAD_WARMUP_RATE=80
LOAD_WARMUP=60s
CONCURRENT_UPLOADS=50
CONCURRENT_FILE_SIZE_BYTES=2097152
