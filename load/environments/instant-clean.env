# Capacity reference node: the Spring service only, not the complete stack.
BACKEND_CPUS=1.0
BACKEND_MEMORY=1g
WORKER_CONCURRENCY=4
ANTIVIRUS_MODE=instant-clean
SPRING_PROFILES_ACTIVE=capacity

# Intentionally identical to real-antivirus.env.
LOAD_RATES=30,50,60,70
LOAD_STEP=60s
LOAD_WARMUP_RATE=30
LOAD_WARMUP=30s
CONCURRENT_UPLOADS=50
CONCURRENT_FILE_SIZE_BYTES=2097152
