# Point 3 — la cible : trois nœuds réalistes (2 CPU, 1 Gio, 8 workers
# chacun, G1) devant une seule base, un seul stockage et un seul antivirus.
# Au-delà de ~250 fichiers/s, c'est le relevé docker stats qui dira quelle
# dépendance bride la première — ClamAV y est le candidat le plus probable.
NODES=3
BACKEND_CPUS=2.0
BACKEND_MEMORY=1g
# Détection de fuite Hikari à 2 s : une connexion gardée plus longtemps est
# journalisée avec l'endroit où elle a été prise (rapport *-database.md).
BACKEND_JVM_OPTIONS=-XX:+UseG1GC -Dspring.datasource.hikari.leak-detection-threshold=2000
WORKER_CONCURRENCY=8
ANTIVIRUS_MODE=http

LOAD_RATES=150,200,250,300
LOAD_STEP=60s
LOAD_WARMUP_RATE=120
LOAD_WARMUP=90s
MAX_VUS=400
CONCURRENT_UPLOADS=50
CONCURRENT_FILE_SIZE_BYTES=2097152
