# Point 3 — trois nœuds identiques aux confirmations (1 CPU, 1 Gio, 4 workers
# chacun), une seule base, un seul stockage, un seul antivirus. Si le débit
# triple (~240 fichiers/s au genou), le service monte en charge en ajoutant
# des nœuds ; sinon, le relevé docker stats dit quelle dépendance bride.
# Échauffement plus long : trois JVM neuves.
NODES=3
BACKEND_CPUS=1.0
BACKEND_MEMORY=1g
WORKER_CONCURRENCY=4
ANTIVIRUS_MODE=http

LOAD_RATES=120,160,200,250
LOAD_STEP=60s
LOAD_WARMUP_RATE=90
LOAD_WARMUP=90s
MAX_VUS=400
CONCURRENT_UPLOADS=50
CONCURRENT_FILE_SIZE_BYTES=2097152
