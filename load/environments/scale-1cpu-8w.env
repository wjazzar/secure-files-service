# Point 3 — le nœud 1 CPU est-il limité par son processeur ou par ses 4
# workers ? Seul le nombre de workers change par rapport aux confirmations.
# Si le débit monte, les workers attendaient (antivirus, stockage) ; s'il ne
# bouge pas, c'est le processeur.
BACKEND_CPUS=1.0
BACKEND_MEMORY=1g
WORKER_CONCURRENCY=8
ANTIVIRUS_MODE=http

LOAD_RATES=70,85,100,120
LOAD_STEP=60s
LOAD_WARMUP_RATE=50
LOAD_WARMUP=60s
MAX_VUS=200
CONCURRENT_UPLOADS=50
CONCURRENT_FILE_SIZE_BYTES=2097152
